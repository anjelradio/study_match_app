# URL de la aplicación Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL de la API de FastAPI
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000/api"
NEXT_PUBLIC_BACKEND_ADAPTER="fastapi"

# Base de datos PostgreSQL para Better Auth (mismo motor de base de datos)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sumate_db"

# Better Auth Configuration
BETTER_AUTH_SECRET="tu-secreto-compartido-seguro"
BETTER_AUTH_URL="http://localhost:3000"

# Configuración JWT (Better Auth emite tokens EdDSA / Ed25519)
JWT_EXPIRATION_TIME="15m"
JWT_ISSUER="http://localhost:3000"
JWT_AUDIENCE=""

# Google OAuth (Para habilitar 'Continuar con Google')
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# Brevo (Envío de correos para verificación de cuenta y reseteo de contraseña)
BREVO_API_KEY="xkeysib-tu-api-key"
BREVO_FROM_EMAIL="notificaciones@tu-dominio.com"
BREVO_FROM_NAME="Súmate"
