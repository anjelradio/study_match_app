PROJECT_NAME="Súmate API"
ENVIRONMENT="DEV"

# Base de datos (PostgreSQL recomendado; SQLite disponible para pruebas rápidas: sqlite:///./dev.db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sumate_db"
SQL_ECHO="false"

# JWT / Auth (EdDSA + JWKS descargado desde Next.js Better Auth)
BETTER_AUTH_SECRET="tu-secreto-compartido-seguro"
FRONTEND_URL="http://localhost:3000"
JWKS_TIMEOUT_SECONDS="5.0"
JWT_ISSUER=""
JWT_AUDIENCE=""
BETTER_AUTH_ENABLE_ROLES="false"

# CORS (URLs del frontend permitidas, separadas por coma)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Cloudinary (Almacenamiento de fotos de actividades comunitarias)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
